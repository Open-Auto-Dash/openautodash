<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#E3F2FD" /> <stroke android:width="2dp" android:color="@color/colorPositive" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/colorBackgroundLight" />
            <stroke android:width="1dp" android:color="@color/colorBackgroundLightBorder" />
        </shape>
    </item>
</selector>